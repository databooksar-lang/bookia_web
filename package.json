    "capacitor-token-vault": "^0.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5"
  }
}
